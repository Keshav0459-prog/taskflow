# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth / Gmail API
# These belong to a dedicated Gmail sender account (e.g. taskflow.notifications@gmail.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-gmail-oauth-refresh-token
GMAIL_SENDER_EMAIL=taskflow.notifications@gmail.com

# CORS — set this to your deployed frontend URL in production
FRONTEND_URL=http://localhost:3000

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
